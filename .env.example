# Production values also ship in easypanel-environment (auto-loaded on Docker deploy).
APP_ENV=production
APP_VERSION=1.0.1
API_BASE_URL=https://api.nafaas.shop
FRONTEND_URL=https://nafaas.shop
CORS_ORIGINS=https://nafaas.shop,https://nasama.shop,https://www.nasama.shop

DATABASE_URL=postgres://nasamashop:nasamashop@nasamashop_databas:5432/nasamashop?sslmode=disable

# Google Sheets Webhook — paste google_apps_script_webhook.js into Apps Script,
# deploy as Web app (Execute as: Me, Access: Anyone), then paste the /exec URL here.
GOOGLE_SHEET_WEBHOOK_URL=
ENABLE_SHEET_WEBHOOK=true

# COD Network — auto-push orders on checkout.
# CHANGE SKU ANYTIME in Easypanel (backend env) then restart the backend service.
# Use the drop-product SKU from COD Network → Drop Products (KSA warehouse).
ENABLE_COD_NETWORK=true
COD_NETWORK_API_TOKEN=

# Option A — one SKU for the whole store (easiest, change anytime):
COD_NETWORK_SKU=HBLEANSPRY3
COD_NETWORK_PRODUCT_NAME=Herbal lung cleansing spray

# Optional — remap a store SKU to a different COD fulfillment SKU:
# COD_NETWORK_SKU_ALIASES=HBLEANSPRY3=MP-IFFGXXE5V84O
# COD_NETWORK_SKU_ALIASES={"HBLEANSPRY3":"MP-IFFGXXE5V84O"}

# Option B — different SKU per product slug (overrides Option A for that slug):
# JSON:
# COD_NETWORK_PRODUCT_MAP={"herbal-lung-spray":{"sku":"HBLEANSPRY3","name":"Herbal lung cleansing spray"}}
# Simple (Easypanel-friendly):
# COD_NETWORK_PRODUCT_MAP=herbal-lung-spray=HBLEANSPRY3|Herbal lung cleansing spray,molien-drops=MOILZOUH|Molien Drops,molien-drops-women=MOILZOUH|Molien Drops
COD_NETWORK_PRODUCT_MAP=herbal-lung-spray=HBLEANSPRY3|Herbal lung cleansing spray,molien-drops=MOILZOUH|Molien Drops,molien-drops-women=MOILZOUH|Molien Drops

COD_NETWORK_API_VERSION=v2
COD_NETWORK_MODE=lead
COD_NETWORK_DEFAULT_CITY=Riyadh
COD_NETWORK_DEFAULT_AREA=Riyadh
COD_NETWORK_DEFAULT_ADDRESS=الرياض - سيتم تأكيد العنوان مع العميل هاتفياً
COD_NETWORK_COUNTRY=Saudi Arabia

# Tracking — set pixel IDs here once (Easypanel backend env).
# Browser pixels are loaded from GET /api/tracking/config (no frontend rebuild needed).
# CAPI sends server-side Purchase events on checkout (requires access tokens too).

# Meta / Facebook — single pixel only (ID is public; keep token secret in Easypanel)
# Env var MUST be META_ACCESS_TOKEN (aliases META_API_TOKEN / FACEBOOK_ACCESS_TOKEN also work).
META_PIXEL_ID=576636091443534
META_ACCESS_TOKEN=
# Generate in Meta Events Manager → your pixel → Settings → Generate access token (starts with EAA...)
# Optional — copy from Meta Events Manager → Test events (required to see CAPI in test tab)
META_TEST_EVENT_CODE=

# TikTok / Snapchat — leave empty unless you use them
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

# Feature flags
ENABLE_CAPI=true
ENABLE_WEB_PIXELS=true

# MaxMind GeoIP2 — KSA country check only (VPN/proxy not blocked).
# If MaxMind is down or misconfigured, orders are still allowed (soft-fail).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_API_HOST=geoip.maxmind.com
ENABLE_GEOIP_CHECK=false
GEOIP_ALLOWED_COUNTRY=SA
# Legacy — secondary VPN provider is ignored; country check only.
ENABLE_SECONDARY_VPN_CHECK=false
# Test phones that bypass GeoIP checks in production (comma-separated)
ORDER_PHONE_WHITELIST=055000000,0550000000
# When false, whitelisted test orders are saved but not sent to sheet/COD/CAPI
PROCESS_TEST_ORDERS=false

# Outbound WhatsApp welcome TO customer after order (Saudi Arabic, brand: نَفَس)
ENABLE_WHATSAPP_WELCOME=true
# Meta WhatsApp Cloud API — from Meta Business → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template (body vars: name, brand, order_number, total)
WHATSAPP_WELCOME_TEMPLATE_NAME=
WHATSAPP_WELCOME_TEMPLATE_LANG=ar
# Or automation webhook (Make/Zapier/n8n) — receives order_welcome JSON + message_ar
WHATSAPP_WELCOME_WEBHOOK_URL=

# Admin dashboard (/admin in frontend, /api/admin/* in backend)
# Use a long, random password. HTTP Basic over HTTPS only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Redirect Monster (/redirectmonster in frontend, /api/redirectmonster/* in backend)
# Separate password from main admin. Used for ad slug redirects at /ads/{slug}.
REDIRECT_MONSTER_USERNAME=monster
REDIRECT_MONSTER_PASSWORD=change-me-to-another-long-random-string
